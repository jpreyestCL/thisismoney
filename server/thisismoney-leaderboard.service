[Unit]
Description=This is Money world leaderboard
After=network.target postgresql.service

[Service]
Type=simple
User=timleaderboard
Group=timleaderboard
WorkingDirectory=/var/www/tim.strivexlatam.com/server
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql:///thisismoney
ExecStart=/usr/bin/node /var/www/tim.strivexlatam.com/server/leaderboard.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/tim.strivexlatam.com/server

[Install]
WantedBy=multi-user.target
